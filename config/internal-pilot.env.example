# Authoritative environment names; intentionally empty required values fail closed.
# Load real values via the approved deployment secret/configuration mechanism.
JMORAIS_PRODUCTION_COMPOSITION_FACTORY=
JMORAIS_WEB_DIST=
JMORAIS_PILOT_ORIGIN=
JMORAIS_PILOT_PORT=
JMORAIS_PILOT_TLS_CERT=
JMORAIS_PILOT_TLS_KEY=
JMORAIS_PILOT_STATE_DIR=
# Optional public CA bundle, never a private key.
JMORAIS_PILOT_CA_FILE=
# Public browser metadata; generate config with apps/web/scripts/runtime-config.py.
JMORAIS_WEB_ENVIRONMENT=PRODUCTION
JMORAIS_WEB_OIDC_ISSUER=
JMORAIS_WEB_OIDC_CLIENT_ID=
JMORAIS_WEB_OIDC_REDIRECT_URI=
JMORAIS_WEB_OIDC_SCOPES=
# DATABASE_URL is used by existing Alembic only when migrating the REAL database.
# Inject the approved migration credential ephemerally; never store it here.
# Server managed keys/credentials are resolved by the approved composition factory.
